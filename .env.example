# Copy this file to .env and fill in the real values.
# .env is gitignored - never commit real secrets.

# --- Inbound API write auth (REQUIRED in production) ---
# The dedicated key clients must send as the X-API-Key header on every
# POST/PUT/DELETE. This is SEPARATE from FLOWSENSE_API_KEY (the upstream
# Pemkab credential) — a write client must never receive the upstream key.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
FLOWSENSE_INBOUND_API_KEY=

# --- Upstream Pemkab Kudus CCTV source (read-only ingest) ---
FLOWSENSE_API_KEY=
FLOWSENSE_API_URL=https://kudussehat.kuduskab.go.id/api/get-cctv
FLOWSENSE_API_TIMEOUT=25
FLOWSENSE_API_RETRIES=3
FLOWSENSE_API_BACKOFF=2
FLOWSENSE_MIN_CONF=0.35
FLOWSENSE_INTERVAL=2
FLOWSENSE_MODEL=yolo11n.pt

# --- Postgres (no weak defaults: set a real password before `docker compose up`) ---
POSTGRES_USER=flowsense
POSTGRES_PASSWORD=
POSTGRES_DB=flowsense

# --- Garage object storage ---
# From inside the docker-compose 'api' service use the service name 'garage'
# as the host; from the host machine use 'localhost'.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=flowsense
# P1-14: must equal s3_region in config/garage.toml (was "us-east-1", now "garage").
GARAGE_REGION=garage
# 64-char hex secret for the Garage node RPC. Generate: `openssl rand -hex 32`.
# Mirrors rpc_secret in config/garage.toml (which is redacted in git).
GARAGE_RPC_SECRET=

# Api service connects to postgres by service name inside the compose network.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
